{
  // The ikada docs app on the Sproutboat Cloud (sproutboat.com/ikada): `sproutboat deploy` from this directory, after `bun run build`, with a
  // team key. The pages are not part of the module: the Cloud keeps dist/ in its asset store and its edge serves it. The module is built by the
  // Cloud's own builder from src/sprout.js, so the Cloud holds the source and a generation swap prebuilds the app for the next runtime like
  // any other (docs/swap.md in sproutboat/cloud).
  "$schema": "https://sproutboat.com/schema.json",
  "name": "ikada-site",
  "main": "src/sprout.js",
  "compatibility_date": "2026-08-31",
  // Served on its own domain only: no <app>.<team>.sproutboat.app address (as Wrangler workers_dev = false; CLI 0.59.0).
  "workers_dev": false,
  "assets": {
    // built by `bun run build`: the pages under dist/ikada, the registry under dist/ikada/r
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // only the bare paths need the handler (redirect to /ikada/); files serve from the asset store
    "run_sprout_first": ["/", "/ikada"],
  },
}
